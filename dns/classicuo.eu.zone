;; classicuo.eu — records to import into Cloudflare DNS after deleting the Aruba leftovers.
;; The two Worker custom-domain records (classicuo.eu, www) are managed by wrangler and are NOT in this file.
;; No mailbox exists on this domain: null MX + hard-fail SPF + reject DMARC stop anyone spoofing @classicuo.eu.

$ORIGIN classicuo.eu.
$TTL 3600

@       IN  MX   0 .
@       IN  TXT  "v=spf1 -all"
_dmarc  IN  TXT  "v=DMARC1; p=reject; adkim=s; aspf=s;"
